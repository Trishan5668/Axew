AXEW_RUST_PORT=7001
AXEW_AI_PORT=7002
AXEW_ENV=development
AXEW_FFMPEG_PATH=ffmpeg
AXEW_FFPROBE_PATH=ffprobe
AXEW_MODELS_DIR=~/.axew/models
AXEW_PROJECTS_DIR=~/.axew/projects
AXEW_CACHE_DIR=~/.axew/cache
OLLAMA_HOST=http://localhost:11434
HF_TOKEN=

# ---------------------------------------------------------------------------
# Cloud features (Track 1/2/3) — OPT-IN. Local-first remains the default;
# do NOT set these unless you intend to enable Supabase auth, Razorpay billing
# and OpusClip post-processing. See docs/CLOUD_INTEGRATION.md.
# ---------------------------------------------------------------------------
AXEW_CLOUD_ENABLED=false

# Supabase (server-side, used by apps/ai-service)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Supabase (renderer-side, used by apps/desktop)
VITE_AXEW_CLOUD_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AXEW_AI_BASE_URL=http://127.0.0.1:7002

# Razorpay (server-side)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Razorpay (renderer-side — public key id only)
VITE_RAZORPAY_KEY_ID=

# OpusClip (server-side only; NEVER expose in any VITE_* var)
OPUSCLIP_API_KEY=
OPUSCLIP_BASE_URL=https://api.opus.pro

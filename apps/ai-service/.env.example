# AXEW AI service — local environment template.
#
# Copy this to `apps/ai-service/.env` and fill in the values you need.
# `main.py` loads this file at startup via python-dotenv (override=False),
# so any value already set in your shell environment wins.
#
# Variables WITHOUT the `AXEW_` prefix are read directly from os.environ
# by middleware/cloud_config.py and the various cloud routers — they are
# NOT pulled in by the AXEW_-prefixed Pydantic Settings class, so they
# must come either from this .env or from your shell.

# ===========================================================================
# Cloud master switch — set to `true` to expose /auth, /payments, /opusclip
# ===========================================================================
AXEW_CLOUD_ENABLED=false

# ===========================================================================
# Supabase (server-side)
# ===========================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ===========================================================================
# Razorpay (server-side)
# ===========================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ===========================================================================
# OpusClip (server-side ONLY — never expose in any VITE_* var)
#
# Required scopes: ability to POST /api/clip-projects and GET
# /api/exportable-clips. Issue from https://www.opus.pro/api on a
# Pro (Beta), Max, or Business plan account.
# ===========================================================================
OPUSCLIP_API_KEY=
OPUSCLIP_BASE_URL=https://api.opus.pro

# ===========================================================================
# Local-only knobs (everything below works without cloud mode)
# ===========================================================================
AXEW_LOG_LEVEL=info

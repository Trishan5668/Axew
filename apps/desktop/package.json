{
  "name": "@axew/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node --input-type=module -e \"import fs from 'fs'; fs.copyFileSync('electron/preload.cjs','dist-electron/preload.cjs')\"",
    "start": "electron .",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist dist-electron"
  },
  "dependencies": {
    "@axew/shared-types": "workspace:*",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "immer": "^10.1.1",
    "lucide-react": "^0.378.0",
    "nanoid": "^5.0.7",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "^2.3.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.0",
    "postcss": "^8.4.38",
    "rimraf": "^5.0.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  }
}
